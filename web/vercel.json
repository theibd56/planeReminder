{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https: http: chrome-extension: moz-extension:" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
